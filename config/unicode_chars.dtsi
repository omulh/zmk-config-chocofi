/* Spanish letters */
ZMK_UNICODE_PAIR(a_acute,       KP_N0, KP_N0, E, KP_N1,    KP_N0, KP_N0, C, KP_N1)  // á/Á
ZMK_UNICODE_PAIR(e_acute,       KP_N0, KP_N0, E, KP_N9,    KP_N0, KP_N0, C, KP_N9)  // é/É
ZMK_UNICODE_PAIR(i_acute,       KP_N0, KP_N0, E, D,        KP_N0, KP_N0, C, D)      // í/Í
ZMK_UNICODE_PAIR(o_acute,       KP_N0, KP_N0, F, KP_N3,    KP_N0, KP_N0, D, KP_N3)  // ó/Ó
ZMK_UNICODE_PAIR(u_acute,       KP_N0, KP_N0, F, A,        KP_N0, KP_N0, D, A)      // ú/Ú
ZMK_UNICODE_PAIR(u_dieresis,    KP_N0, KP_N0, F, C,        KP_N0, KP_N0, D, C)      // ü/Ü
ZMK_UNICODE_PAIR(n_tilde,       KP_N0, KP_N0, F, KP_N1,    KP_N0, KP_N0, D, KP_N1)  // ñ/Ñ

/* German umlauts */
ZMK_UNICODE_PAIR(ae,        KP_N0, KP_N0, E, KP_N4,    KP_N0, KP_N0, C, KP_N4)  // ä/Ä
ZMK_UNICODE_PAIR(oe,        KP_N0, KP_N0, F, KP_N6,    KP_N0, KP_N0, D, KP_N6)  // ö/Ö
ZMK_UNICODE_PAIR(ue,        KP_N0, KP_N0, F, C,        KP_N0, KP_N0, D, C)      // ü/Ü
ZMK_UNICODE_PAIR(eszett,    KP_N0, KP_N0, D, F,        KP_N1, E, KP_N9, E)      // ß/ẞ

/* Symbols */
ZMK_UNICODE_SINGLE(degree,     KP_N0, KP_N0, B, KP_N0)  // ° (degree)
ZMK_UNICODE_SINGLE(euro,       KP_N2, KP_N0, A, C)      // € (Euro)
ZMK_UNICODE_SINGLE(inv_qstn,   KP_N0, KP_N0, B, F)      // ¿ (inverted question mark)
ZMK_UNICODE_SINGLE(inv_excl,   KP_N0, KP_N0, A, KP_N1)  // ¡ (inverted exclamation mark)
ZMK_UNICODE_SINGLE(mu_prefix,  KP_N0, KP_N3, B, C)      // μ (prefix micro)
ZMK_UNICODE_SINGLE(pi_math,    KP_N0, KP_N3, C, KP_N0)  // π (math pi)
