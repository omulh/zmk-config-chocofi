#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/rgbled_widget.dtsi>

#include "unicode_helpers.h"
#include "unicode_chars.dtsi"

&caps_word { continue-list = <UNDERSCORE DOT BACKSPACE DELETE>; };

&mmv { time-to-max-speed-ms = <100>; };

&msc { time-to-max-speed-ms = <100>; };

/ {
    behaviors {
        dot_colon: dot_colon_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot/Colon Morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi: comma_semicolon_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Comma/Semicolon Morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sqt_sl7: single_quote_sticky_layer_7_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Single Quote / Sticky Layer 7 Morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&sl 7>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        fslh_sl8: forward_slash_sticky_layer_8_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Forward Slash / Sticky Layer 8 Morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&sl 8>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        sz_ht: eszett_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Balanced Key/Eszett Hold/Tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&eszett>;

            flavor = "balanced";
            tapping-term-ms = <250>;
        };

        e_ht: acute_e_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Balanced Key/Acute E Hold/Tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&e_acute>;

            flavor = "balanced";
            tapping-term-ms = <250>;
        };

        lhm_ht: left_homerow_mod_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Left Homerow Mod Hold/Tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        rhm_ht: right_homerow_mod_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Right Homerow Mod Hold/Tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
        };

        lk_ht: layer_key_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Balanced Layer/Key Hold/Tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
        };

        mml_td: mouse_move_left_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse Move Left Tap Dance";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_X(-330)>, <&mmv MOVE_X(-1000)>;
        };

        mmr_td: mouse_move_right_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse Move Right Tap Dance";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_X(330)>, <&mmv MOVE_X(1000)>;
        };

        mmu_td: mouse_move_up_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse Move Up Tap Dance";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_Y(-330)>, <&mmv MOVE_Y(-1000)>;
        };

        mmd_td: mouse_move_down_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse Move Down Tap Dance";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_Y(330)>, <&mmv MOVE_Y(1000)>;
        };

        msl_td: mouse_scroll_left_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse scroll left tap Dance";
            #binding-cells = <0>;
            bindings = <&msc MOVE_X(-10)>, <&msc MOVE_X(-30)>;
        };

        msr_td: mouse_scroll_right_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse Scroll Right Tap Dance";
            #binding-cells = <0>;
            bindings = <&msc MOVE_X(10)>, <&msc MOVE_X(30)>;
        };

        msd_td: mouse_scroll_down_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse Scroll Down Tap Dance";
            #binding-cells = <0>;
            bindings = <&msc MOVE_Y(-10)>, <&msc MOVE_Y(-30)>;
        };

        msu_td: mouse_scroll_up_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Mouse Scroll Up Tap Dance";
            #binding-cells = <0>;
            bindings = <&msc MOVE_Y(10)>, <&msc MOVE_Y(30)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_mouse {
            bindings = <&to 10>;
            key-positions = <34 35 33>;
            layers = <0>;
        };

        combo_conf {
            bindings = <&sl 9>;
            key-positions = <30 31 32>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak DH";
            bindings = <
&kp Q  &kp W            &kp F            &kp P           &kp B           &kp J          &kp L           &kp U            &kp Y            &sqt_sl7
&kp A  &lhm_ht LCTRL R  &lhm_ht LSHFT S  &lhm_ht LALT T  &kp G           &kp M          &rhm_ht RALT N  &rhm_ht RSHFT E  &rhm_ht RCTRL I  &kp O
&kp Z  &kp X            &kp C            &lhm_ht LGUI D  &kp V           &kp K          &rhm_ht RGUI H  &comma_semi      &dot_colon       &fslh_sl8
                        &lk_ht 5 TAB     &lk_ht 1 SPACE  &lk_ht 3 ESC    &lk_ht 4 BSPC  &lk_ht 2 RET    &lk_ht 6 DEL
            >;
        };

        sym1 {
            display-name = "Symbols 1";
            bindings = <
&none  &none      &none      &none     &none    &kp TILDE  &kp LT     &kp GT      &kp UNDER  &none
&none  &kp LCTRL  &kp LSHFT  &kp LALT  &none    &kp GRAVE  &kp LPAR   &kp RPAR    &kp MINUS  &kp AT
&none  &none      &none      &kp LGUI  &none    &none      &kp CARET  &kp DLLR    &kp AMPS   &none
                  &none      &trans    &none    &none      &none      &caps_word
            >;
        };

        num {
            display-name = "Numbers";
            bindings = <
&none  &none      &none      &none     &none    &kp KP_DIVIDE    &kp N7  &kp N8  &kp N9  &kp KP_MINUS
&none  &kp LCTRL  &kp LSHFT  &kp LALT  &none    &kp N0           &kp N1  &kp N2  &kp N3  &kp DOT
&none  &none      &none      &kp LGUI  &none    &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6  &kp KP_PLUS
                  &none      &none     &none    &none            &trans  &none
            >;
        };

        sym2 {
            display-name = "Symbols 2";
            bindings = <
&none  &none      &none      &none     &none     &kp PLUS   &kp LBRC  &kp RIGHT_BRACE  &kp PIPE   &none
&none  &kp LCTRL  &kp LSHFT  &kp LALT  &none     &kp EQUAL  &kp LBKT  &kp RBKT         &kp BSLH   &kp EXCL
&none  &none      &none      &kp LGUI  &none     &none      &kp HASH  &kp STAR         &kp PRCNT  &none
                  &none      &none     &trans    &none      &none     &kp CAPS
            >;
        };

        navi {
            display-name = "Navigation";
            bindings = <
&none  &none      &none      &none     &none    &kp HOME  &kp PG_DN    &kp PG_UP        &kp END    &kp INS
&none  &kp LCTRL  &kp LSHFT  &kp LALT  &none    &kp LEFT  &kp DOWN     &kp UP           &kp RIGHT  &kp PSCRN
&none  &none      &none      &kp LGUI  &none    &none     &kp LC(TAB)  &kp LC(LS(TAB))  &none      &kp K_CMENU
                  &none      &none     &none    &trans    &none        &none
            >;
        };

        fun {
            display-name = "Function Keys";
            bindings = <
&none  &none      &none      &none     &none    &kp F12  &kp F7  &kp F8       &kp F9  &none
&none  &kp LCTRL  &kp LSHFT  &kp LALT  &none    &kp F10  &kp F1  &kp F2       &kp F3  &none
&none  &none      &none      &kp LGUI  &none    &kp F11  &kp F4  &kp F5       &kp F6  &none
                  &trans     &none     &none    &none    &none   &kp KP_NLCK
            >;
        };

        media {
            display-name = "Media Keys";
            bindings = <
&none  &none  &none  &none     &none    &kp C_PREV       &kp C_PAUSE        &kp C_PLAY_PAUSE   &kp C_NEXT        &kp C_AL_CALC
&none  &none  &none  &ind_bat  &none    &kp C_MUTE       &kp C_VOL_DN       &kp C_VOL_UP       &kp RG(RA(K))     &kp RG(RS(S))
&none  &none  &none  &ind_con  &none    &kp RG(RS(END))  &kp RG(RS(PG_DN))  &kp RG(RS(PG_UP))  &kp RG(RS(HOME))  &kp RG(L)
              &none  &none     &none    &none            &none              &trans
            >;
        };

        es-unicode {
            display-name = "Spanish Unicode Characters";
            bindings = <
&none     &none  &none      &none  &none    &none  &none     &u_acute       &none     &inv_excl
&a_acute  &none  &kp LSHFT  &none  &none    &none  &n_tilde  &e_ht RSHFT 0  &i_acute  &o_acute
&none     &none  &none      &none  &none    &none  &none     &none          &none     &inv_qstn
                 &none      &none  &to 0    &none  &none     &none
            >;
        };

        de-unicode {
            display-name = "German Unicode Characters";
            bindings = <
&none  &none  &none           &none  &none    &degree     &none  &ue        &none  &none
&ae    &none  &sz_ht LSHFT 0  &none  &none    &mu_prefix  &none  &kp RSHFT  &none  &oe
&none  &none  &none           &none  &none    &none       &none  &euro      &none  &none
              &none           &none  &to 0    &none       &none  &none
            >;
        };

        conf {
            display-name = "Configuration";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &bt BT_CLR      &none  &none  &none  &none  &none
&none         &none         &none         &none  &out OUT_BLE    &none  &none  &none  &none  &none
&none         &none         &none         &none  &out OUT_USB    &none  &none  &none  &none  &none
                            &none         &none  &none           &none  &none  &none
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&none  &none  &none  &none  &none    &msl_td    &msd_td    &mmu_td    &msu_td  &msr_td
&none  &none  &none  &none  &none    &mkp MB4   &mml_td    &mmd_td    &mmr_td  &mkp MB5
&none  &none  &none  &none  &none    &none      &none      &none      &none    &none
              &none  &none  &to 0    &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };
    };
};
