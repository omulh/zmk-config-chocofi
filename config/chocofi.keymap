#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/rgbled_widget.dtsi>

#define TD_TAPPING_TERM_MS 200
#define HT_TAPPING_TERM_MS 250
#define QUICK_TAP_MS 200
#define REQUIRE_PRIOR_IDLE_MS 150

#define CVS 250
#define CVF 1250
#define SVS 150
#define SVF 1600

&caps_word { continue-list = <UNDERSCORE DOT BACKSPACE DELETE>; };

/ {
    behaviors {
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            display-name = "Sticky Key Quick Release";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        sls: sticky_layer_slow_release {
            compatible = "zmk,behavior-sticky-key";
            display-name = "Sticky Layer Slow Release";
            #binding-cells = <1>;
            release-after-ms = <1000>;
            bindings = <&mo>;
        };

        sll: sticky_layer_long {
            compatible = "zmk,behavior-sticky-key";
            display-name = "Sticky Layer Long Wait";
            #binding-cells = <1>;
            release-after-ms = <2500>;
            quick-release;
            bindings = <&mo>;
        };

        magic_shift: shift_caps_word_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Shift/Caps Word Morph";
            #binding-cells = <0>;
            bindings = <&skq LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };

        dot_colon: dot_colon_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot/Colon Morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi: comma_semicolon_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Comma/Semicolon Morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_ht: magic_shift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Magic Shift Hold/Tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&magic_shift>;

            flavor = "balanced";
            tapping-term-ms = <HT_TAPPING_TERM_MS>;
        };

        lhm_ht: left_homerow_mod_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Left Homerow Mod Hold/Tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HT_TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        rhm_ht: right_homerow_mod_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Right Homerow Mod Hold/Tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HT_TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
        };

        lk_ht: layer_key_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer/Key Hold/Tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HT_TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
        };

        lsls_ht: layer_sticky_layer_slow_release_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer/Sticky Layer Slow Release Hold/Tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sls>;

            flavor = "balanced";
            tapping-term-ms = <HT_TAPPING_TERM_MS>;
        };

        lsl_ht: layer_sticky_layer_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer/Sticky Layer Hold/Tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sl>;

            flavor = "balanced";
            tapping-term-ms = <HT_TAPPING_TERM_MS>;
        };
    };

    macros {
        user: username_macro {
            compatible = "zmk,behavior-macro";
            display-name = "Username Macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp L &kp H &kp DOT &kp X &kp Y &kp Z>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
        };

        combo_bspace {
            bindings = <&kp BSPC>;
            key-positions = <1 2>;
            layers = <0>;
        };

        combo_del {
            bindings = <&kp DEL>;
            key-positions = <2 3>;
            layers = <0>;
        };

        combo_ret {
            bindings = <&kp RET>;
            key-positions = <3 4>;
            layers = <0>;
        };

        combo_space {
            bindings = <&kp SPACE>;
            key-positions = <10 11>;
            layers = <0>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
            layers = <0>;
        };

        combo_conf {
            bindings = <&sll 6>;
            key-positions = <6 7 8>;
            layers = <0>;
        };

        combo_mouse {
            bindings = <&to 7>;
            key-positions = <16 17 18>;
            layers = <0>;
        };

        combo_exit_mouse {
            bindings = <&to 0>;
            key-positions = <16 17 18>;
            layers = <7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak DH";
            bindings = <
&kp Q  &kp W           &kp F            &kp P            &kp B             &kp J         &kp L            &kp U            &kp Y           &kp SQT
&kp A  &lhm_ht LGUI R  &lhm_ht LSHFT S  &lhm_ht LCTRL T  &kp G             &kp M         &rhm_ht RCTRL N  &rhm_ht RSHFT E  &rhm_ht RGUI I  &kp O
&kp Z  &kp X           &kp C            &lhm_ht LALT D   &kp V             &kp K         &rhm_ht LALT H   &comma_semi      &dot_colon      &kp FSLH
                       &lsl_ht 4 4      &lsls_ht 1 1     &ms_ht LSHFT 0    &lk_ht 3 RET  &lk_ht 2 SPACE   &lk_ht 5 BSPC
            >;
        };

        sym {
            display-name = "Symbols";
            bindings = <
&none   &kp PLUS            &kp LBRC            &kp RBRC            &kp PIPE    &kp TILDE  &kp LT              &kp GT              &kp UNDER           &kp RA(SQT)
&kp AT  &lhm_ht LGUI EQUAL  &lhm_ht LSHFT LBKT  &lhm_ht LCTRL RBKT  &kp BSLH    &kp GRAVE  &rhm_ht RCTRL LPAR  &rhm_ht RSHFT RPAR  &rhm_ht RGUI MINUS  &kp EXCL
&none   &kp PRCNT           &kp HASH            &lhm_ht LALT STAR   &none       &none      &rhm_ht LALT CARET  &kp DLLR            &kp AMPS            &kp RA(DQT)
                            &none               &trans              &to 0       &kp ESC    &kp TAB             &kp DEL
            >;
        };

        navi {
            display-name = "Navigation";
            bindings = <
&none  &none     &none      &none      &none    &kp HOME         &kp PG_DN  &kp PG_UP  &kp END      &kp INS
&none  &kp LGUI  &kp LSHFT  &kp LCTRL  &none    &kp LEFT         &kp DOWN   &kp UP     &kp RIGHT    &kp PSCRN
&none  &none     &none      &kp LALT   &none    &kp LC(LS(TAB))  &none      &none      &kp LC(TAB)  &kp K_CMENU
                 &none      &none      &none    &none            &trans     &none
            >;
        };

        num {
            display-name = "Numbers";
            bindings = <
&none  &none     &none      &none      &none    &kp KP_DIVIDE    &kp N7  &kp N8  &kp N9  &kp KP_MINUS
&none  &kp LGUI  &kp LSHFT  &kp LCTRL  &none    &kp N0           &kp N4  &kp N5  &kp N6  &kp DOT
&none  &none     &none      &kp LALT   &none    &kp KP_MULTIPLY  &kp N1  &kp N2  &kp N3  &kp KP_PLUS
                 &none      &none      &none    &trans           &none   &none
            >;
        };

        fun {
            display-name = "Function Keys";
            bindings = <
&none  &none     &none      &none      &user    &kp F12   &kp F7    &kp F8       &kp F9  &none
&none  &sk LGUI  &sk LSHFT  &sk LCTRL  &none    &kp F11   &kp F4    &kp F5       &kp F6  &none
&none  &none     &none      &sk LALT   &none    &kp F10   &kp F1    &kp F2       &kp F3  &none
                 &trans     &none      &to 0    &sk RALT  &kp CAPS  &kp KP_NLCK
            >;
        };

        media {
            display-name = "Media Keys";
            bindings = <
&none  &none  &none  &none     &none    &kp C_PREV  &kp C_PAUSE   &kp C_PLAY    &kp C_NEXT         &kp C_AL_CALC
&none  &none  &none  &ind_bat  &none    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp LG(LC(LS(A)))  &kp LG(LS(S))
&none  &none  &none  &ind_con  &none    &none       &kp C_BRI_DN  &kp C_BRI_UP  &none              &kp LG(LC(LS(L)))
              &none  &none     &none    &none       &none         &trans
            >;
        };

        conf {
            display-name = "Configuration";
            bindings = <
&none  &none  &none  &none  &none    &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR
&none  &none  &none  &none  &none    &out OUT_USB  &none         &none         &none         &none
&none  &none  &none  &none  &none    &none         &none         &none         &none         &none
              &none  &none  &none    &to 0         &none         &none
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&none  &none     &none      &none      &none    &none              &msc MOVE_Y(-SVF)  &mmv MOVE_Y(-CVF)  &msc MOVE_Y(SVF)  &none
&none  &kp LGUI  &kp LSHFT  &kp LCTRL  &none    &msc MOVE_X(-SVF)  &mmv MOVE_X(-CVF)  &mmv MOVE_Y(CVF)   &mmv MOVE_X(CVF)  &msc MOVE_X(SVF)
&none  &none     &none      &kp LALT   &none    &none              &mkp MB4           &mkp MB3           &mkp MB5          &none
                 &none      &mo 8      &to 0    &mkp LCLK          &mo 8              &mkp RCLK
            >;
        };

        slow_mouse {
            display-name = "Slow Mouse";
            bindings = <
&none  &none     &none      &none      &none    &none              &msc MOVE_Y(-SVS)  &mmv MOVE_Y(-CVS)  &msc MOVE_Y(SVS)  &none
&none  &kp LGUI  &kp LSHFT  &kp LCTRL  &none    &msc MOVE_X(-SVS)  &mmv MOVE_X(-CVS)  &mmv MOVE_Y(CVS)   &mmv MOVE_X(CVS)  &msc MOVE_X(SVS)
&none  &none     &none      &kp LALT   &none    &none              &none              &none              &none             &none
                 &none      &trans     &none    &mkp LCLK          &trans             &mkp RCLK
            >;
        };
    };
};
