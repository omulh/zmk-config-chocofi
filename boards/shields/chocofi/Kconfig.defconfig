if SHIELD_CHOCOFI_LEFT

# Name must be less than 16 characters long
config ZMK_KEYBOARD_NAME
    default "Chocofi"

# This side as central
config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Number of peripherals to connect to the central
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 1

# Maximum simultaneous BT connections
# (incl. peripherals and host profiles)
config BT_MAX_CONN
    default 4

# Maximum paired BT devices
config BT_MAX_PAIRED
    default 4

endif

if SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT

config ZMK_SPLIT
    default y

# Enable deep sleep support
config ZMK_SLEEP
    default y

config ZMK_IDLE_SLEEP_TIMEOUT
    default 60000

endif
