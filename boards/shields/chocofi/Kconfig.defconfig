if SHIELD_CHOCOFI_DONGLE

# Name of the BT device
# (must be less than 16 characters long)
config ZMK_KEYBOARD_NAME
    default "Chocofi"

# Dongle as the central part
config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Number of peripherals to connect to the central
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Maximum simultaneous BT connections
# (incl. peripherals and host profiles)
config BT_MAX_CONN
    default 5

# Maximum paired BT devices
config BT_MAX_PAIRED
    default 5

# Needed for concurrent GATT discovery of splits
config BT_L2CAP_TX_BUF_COUNT
    default 15 if ZMK_SPLIT_ROLE_CENTRAL

endif

if SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT

# Enable sleep support
config ZMK_SLEEP
    default y

endif

if SHIELD_CHOCOFI_DONGLE || SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT

# Enable split support
config ZMK_SPLIT
    default y

endif
