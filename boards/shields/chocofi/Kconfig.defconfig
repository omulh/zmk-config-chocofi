if SHIELD_CHOCOFI_DONGLE

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "Chocofi"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config BT_MAX_CONN
    default 5

config BT_MAX_PAIRED
    default 5

endif

if SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT

# Enable sleep support
config ZMK_SLEEP
    default y

# Sleep timeout of 30 mins
config ZMK_IDLE_SLEEP_TIMEOUT
    default 1800000

endif

if SHIELD_CHOCOFI_DONGLE || SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT

# Enable split support
config ZMK_SPLIT
    default y

endif
